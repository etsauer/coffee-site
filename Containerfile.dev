# Local-dev only: Hugo server with live reload. Not the production image.
# Pinned to Hugo v0.165.0. Keep in sync with the production Containerfile.
# Build/run with Podman (see README). Do not use Docker.
FROM docker.io/library/ruby:3.2-bookworm

ARG HUGO_VERSION=0.165.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && gem install asciidoctor --no-document \
    && wget -qO /tmp/hugo.tgz \
        "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_${HUGO_VERSION}_linux-amd64.tar.gz" \
    && tar -xzf /tmp/hugo.tgz -C /usr/local/bin hugo \
    && rm /tmp/hugo.tgz \
    && hugo version

WORKDIR /src
EXPOSE 1313

# --appendPort=false: baseURL already includes :1313 (config.toml is http://mre.coffee/).
CMD ["hugo", "server", \
     "--bind", "0.0.0.0", \
     "--port", "1313", \
     "--baseURL", "http://localhost:1313/", \
     "--appendPort=false"]
